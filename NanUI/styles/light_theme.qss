/*-------------标签（Label）-------------*/

QLabel {
    color: #000000;
    background-color: #ecf0f1;
    border-radius: 8px;
    padding: 6px 12px;
    border: none;
    min-height: 20px;
    max-height: 50px;
    height: 30px;
    font-weight: normal;
}

/*-------------窗口（Window）（由 Deepseek 网页端提供）-------------*/
/* 标题栏（正常状态） */
QWidget#titleBar {
    background-color: #ecf0f1;
    border-top-left-radius: 12px;   /* 与 Window(radius=12) 默认一致，运行时由代码按实际 radius 覆盖 */
    border-top-right-radius: 12px;
}
/* 标题栏内的标题文字：背景透明，不受全局 QLabel 背景影响 */
QLabel#titleLabel {
    background: transparent;
    border: none;
}
/* 内容区域（正常状态） */
QWidget#contentWidget {
    background-color: #f5f7fa;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

/* 标题栏按钮（Window 内置，objectName = captionButton）
   按钮外观由 paintEvent 自绘、颜色取自 theme_manager 的 THEME_COLORS，
   这里只压掉全局 QPushButton 的 padding / min-height，防止撑坏 30x30 的按钮尺寸。 */
QPushButton#captionButton {
    padding: 0;
    min-height: 0;
    max-height: none;
    border: none;
    background: transparent;
}

/*
 * 窗口最大化时由 _update_appearance() -> _apply_corner_style() 动态覆盖，
 * 给标题栏和内容区各加一条只含 border-radius: 0 的样式，抹平四角；
 * 恢复时清空这两条内联样式，圆角重新交回上面 / 主题 QSS 的设定。
 */

/*-------------按钮（PushButton）-------------*/

QPushButton {
    background-color: #e8f0fe;
    border-radius: 8px;
    padding: 6px 12px;
    color: #000000;
    min-height: 20px;
    max-height: 50px;
    height: 30px;
    font-weight: normal;
}
QPushButton:hover {
    /* background-color: #d0e0f5; */
    background-color: #e0ecff;
}
QPushButton:pressed {
    background-color: #cfe0f8;      /* 原先写的是 #e8f0fe，与普通态同色，按下毫无反馈 */
}
QPushButton:disabled {
    background-color: #e0e0e0;
    color: #a0a0a0;
}

/*-------------单行输入框（LineEdit）-------------*/

QLineEdit {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 8px;
    padding: 6px 12px;
    color: #1c1c1c;
    min-height: 20px;
    max-height: 40px;
    font-size: 14px;
}
QLineEdit:focus {
    border-color: #e0ecff;
    /* background-color: #fafcff; */
}
QLineEdit::placeholder {
    color: #a0b0c0;
}

/*-------------菜单（QMenu）-------------*/

QMenu {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 8px;
    padding: 6px 0px;
}
QMenu::item {
    padding: 6px 24px;
    color: #1c1c1c;
    background-color: transparent;
}
QMenu::item:selected {
    background-color: #e8f0fe;
    color: #000000;
}
QMenu::item:pressed {
    background-color: #d0e0f5;
}
QMenu::separator {
    height: 1px;
    background: #d0d7de;
    margin: 4px 12px;
}
QMenu::icon {
    width: 0px;
}

/*-------------多行文本框（TextEdit）-------------*/
QTextEdit {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 8px;
    padding: 6px 12px;
    color: #1c1c1c;
    font-size: 14px;
    min-height: 60px;
}
QTextEdit:focus {
    border-color: #e0ecff;
    /* background-color: #fafcff;*/
}
QTextEdit::selection {
    background-color: #e0ecff;
    color: #1c1c1c;
}

/*-------------复选框（CheckBox）（由 DeepSeek 网页版提供）-------------*/
QCheckBox {
    background-color: transparent;
    color: #1c1c1c;
    font-size: 14px;
    spacing: 8px;          /* 文本与指示器之间的间距 */
    padding: 4px 0px;
}

/* 指示器（方框） */
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 2px solid #d0d7de;
    background-color: transparent;
}
QCheckBox::indicator:hover {
    border-color: #a0b0c0;
    background-color: transparent;
}
QCheckBox::indicator:pressed {
    border-color: #8a9cb0;
    background-color: transparent;
}

/* 选中状态 */
QCheckBox::indicator:checked {
    background-color: transparent;
    border-color: #d0d7de;
    image: url(:/icons/check);
}

QCheckBox::indicator:checked:hover {
    border-color: #a0b0c0;
    background-color: transparent;
}
QCheckBox::indicator:checked:pressed {
    border-color: #8a9cb0;
    background-color: transparent;
}

/* 禁用状态 */
QCheckBox:disabled {
    color: #a0a0a0;
}
QCheckBox::indicator:disabled {
    border-color: #d0d7de;
    background-color: #f0f2f5;
}
QCheckBox::indicator:checked:disabled {
    background-color: #b0b8c4;
}

/*-------------单选按钮（RadioButton）-------------*/

QRadioButton {
    background-color: transparent;
    color: #1c1c1c;
    font-size: 14px;
    spacing: 8px;
    padding: 4px 0px;
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 9px;
    border: 2px solid #d0d7de;
    background-color: transparent;
}
QRadioButton::indicator:hover {
    border-color: #a0b0c0;
}
QRadioButton::indicator:pressed {
    border-color: #8a9cb0;
}
QRadioButton::indicator:checked {
    background-color: #3498db;
    border-color: #d0d7de;
}
QRadioButton::indicator:checked:hover {
    background-color: #2980b9;
    border-color: #a0b0c0;
}
QRadioButton::indicator:checked:pressed {
    background-color: #3498db;
    border-color: #8a9cb0;
}
QRadioButton:disabled {
    color: #a0a0a0;
}
QRadioButton::indicator:disabled {
    border-color: #d0d7de;
    background-color: #f0f2f5;
}
QRadioButton::indicator:checked:disabled {
    background-color: #b0b8c4;
    border-color: #b0b8c4;
}

/*-------------下拉选择框（ComboBox）（由 DeepSeek 网页端提供）-------------*/

QComboBox {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 8px;
    padding: 6px 12px;
    color: #1c1c1c;
    min-height: 20px;
    max-height: 40px;
    font-size: 10.5pt;
    padding-right: 30px;   /* 为箭头留出空间 */
}
QComboBox:hover {
    border-color: #a0b0c0;
}
QComboBox:pressed {
    border-color: #8a9cb0;
}
QComboBox:focus {
    border-color: #e0ecff;
}
QComboBox:disabled {
    background-color: #f0f2f5;
    color: #a0a0a0;
    border-color: #d0d7de;
}

/* 下拉箭头（指示器） */
QComboBox::drop-down {
    border: none;                /* 去掉默认的边框 */
    width: 30px;
    background-color: transparent;
    subcontrol-origin: padding;
    subcontrol-position: right center;  /* 箭头居中 */
}
/* 下拉箭头：QSS 接管 drop-down 区域后原生三角不再绘制，
   必须显式提供图片。图标由 resources.qrc 提供并经 pyside6-rcc 编译进 resources_rc.py */
QComboBox::down-arrow {
    image: url(:/icons/arrow_down);
    margin-right: 6px;
}

/* 下拉列表（弹出视图） */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 8px;
    padding: 4px 0px;
    outline: none;
    /* 可选：添加阴影效果（但 QSS 不支持 box-shadow，可忽略） */
}
QComboBox QAbstractItemView::item {
    padding: 4px 12px;
    color: #1c1c1c;
    background-color: transparent;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #e8f0fe;
    color: #000000;
}
QComboBox QAbstractItemView::item:selected {
    background-color: #d0e0f5;
    color: #1c1c1c;
}
/* 禁用状态的项 */
QComboBox QAbstractItemView::item:disabled {
    color: #a0a0a0;
}

/*-------------进度条（ProgressBar）-------------*/
QProgressBar {
    background-color: #f0f2f5;
    border: 1px solid #d0d7de;
    border-radius: 10px;
    text-align: center;
    font-size: 12px;
    color: #1c1c1c;
    min-height: 20px;
    max-height: 30px;
    padding: 0px 4px;
}
QProgressBar::chunk {
    background-color: #cfe1fc;
    border-radius: 8px;
    margin: 2px 0px;
}

/*-------------卡片（Card）-------------*/
QFrame#card {
    background-color: #ffffff;
    border-radius: 8px;
    border: 1px solid #d0d7de;
}

/*-------------滚动区域（ScrollArea）（由 DeepSeek 网页版提供）-------------*/
QScrollArea {
    background-color: #f5f7fa;      /* 与 Window 内容区背景一致 */
    border: 1px solid #d0d7de;      /* 与 LineEdit 边框一致 */
    border-radius: 8px;             /* 与其它控件统一的圆角 */
}

/* 滚动区域内部的容器（让内容与边框保持一点距离，更美观） */
QScrollArea > QWidget > QWidget {
    background-color: transparent;  /* 保持透明，显示父级背景 */
}

/* ===== 滚动条（ScrollBar）通用样式 ===== */
/* 滚动条的宽度/高度 */
QScrollBar:vertical {
    background: transparent;        /* 轨道背景透明 */
    width: 8px;                    /* 垂直滚动条宽度，细条更现代[reference:13] */
    margin: 2px 0px;               /* 上下留边距，避免与圆角重叠 */
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0px 2px;
}

/* 滚动条滑块（手柄） */
QScrollBar::handle:vertical {
    background: #c1c1c1;            /* 滑块颜色 */
    border-radius: 4px;             /* 圆角滑块[reference:14] */
    min-height: 20px;               /* 防止滑块太小 */
}
QScrollBar::handle:horizontal {
    background: #c1c1c1;
    border-radius: 4px;
    min-width: 20px;
}

/* 滑块悬停效果 */
QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #a0a0a0;            /* 悬停时变深色，提供反馈[reference:15] */
}

/* 滚动条两端按钮（上下箭头）——隐藏，现代 UI 通常不需要[reference:16] */
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0px;
    width: 0px;
    background: transparent;
}

/* 滚动条空白区域（滑块上下方）——透明 */
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}
/*-------------NanUI 扩展组件-------------*/
QPushButton#nanSwitch { background: transparent; border: none; padding: 0; min-height: 0; }
QSlider#nanSlider::groove:horizontal { height: 6px; background: #e3e8ef; border-radius: 3px; }
QSlider#nanSlider::sub-page:horizontal { background: #8fb5fb; border-radius: 3px; }
QSlider#nanSlider::handle:horizontal { width: 16px; margin: -5px 0; background: #ffffff; border: 2px solid #4f86f7; border-radius: 8px; }
QSlider#nanSlider::groove:vertical { width: 6px; background: #e3e8ef; border-radius: 3px; }
QSlider#nanSlider::add-page:vertical { background: #8fb5fb; border-radius: 3px; }
QSlider#nanSlider::handle:vertical { height: 16px; margin: 0 -5px; background: #ffffff; border: 2px solid #4f86f7; border-radius: 8px; }
QSpinBox#nanSpinBox { background:#ffffff; border:1px solid #d0d7de; border-radius:8px; padding:6px 8px; min-height:26px; }
QWidget#segmentedControl { background:#edf1f6; border-radius:10px; }
QPushButton#segmentButton { background:transparent; border:none; border-radius:7px; padding:5px 12px; min-height:22px; }
QPushButton#segmentButton:checked { background:#ffffff; border:1px solid #d0d7de; }
QLabel#badge { color:#ffffff; background:#e5484d; border-radius:9px; padding:0px 5px; font-size:11px; font-weight:600; min-height:18px; max-height:18px; }
QFrame#toast { background:#ffffff; border:1px solid #d0d7de; border-radius:10px; }
QLabel#toastLabel { background:transparent; padding:0; min-height:0; color:#1c1c1c; }
QDialog#nanDialog { background:#f5f7fa; }
QLabel#dialogTitle { background:transparent; font-size:16px; font-weight:600; padding:2px 0; }
QFrame#skeleton { background:#e8edf3; border:none; border-radius:8px; }
QFrame#navigationSideBar { background:#ffffff; border:1px solid #d0d7de; border-radius:10px; }
QPushButton#navItem { background:transparent; border:none; text-align:left; }
QPushButton#navItem:checked { background:#e8f0fe; }
QPushButton#navCollapseButton { background:transparent; border:none; }
QTabWidget#nanTabWidget::pane { border:1px solid #d0d7de; border-radius:8px; top:-1px; }
QTabWidget#nanTabWidget QTabBar::tab { background:transparent; padding:7px 14px; border-bottom:2px solid transparent; }
QTabWidget#nanTabWidget QTabBar::tab:selected { color:#245dcc; border-bottom:2px solid #4f86f7; }
QFrame#dividerLine { color:#d8dee6; background:#d8dee6; max-height:1px; max-width:1px; border:none; }
QLabel#dividerText { background:transparent; color:#6b7280; padding:0 4px; min-height:0; }
QFrame#collapsible { border:1px solid #d0d7de; border-radius:8px; background:#ffffff; }
QPushButton#collapsibleHeader { border:none; border-radius:8px; text-align:left; background:transparent; }
QWidget#collapsibleContent { background:transparent; }
QTableWidget#nanTable, QListWidget#nanListView { background:#ffffff; alternate-background-color:#f7f9fb; border:1px solid #d0d7de; border-radius:8px; outline:none; }
QTableWidget#nanTable::item:selected, QListWidget#nanListView::item:selected { background:#e8f0fe; color:#1c1c1c; border-radius:5px; }
QTableWidget#nanTable QHeaderView::section { background:#f1f4f8; border:none; border-bottom:1px solid #d0d7de; padding:7px; }
QLabel#filePickerLabel { background:#ffffff; border:1px solid #d0d7de; border-radius:8px; padding:6px 10px; }
QFrame#dropZone { border:2px dashed #b8c2cf; border-radius:12px; background:#fafcff; min-height:100px; }
QLabel#dropZoneLabel { background:transparent; color:#667085; }
QMenu#nanContextMenu { border-radius:10px; }
QToolTip { color:#1c1c1c; background:#ffffff; border:1px solid #d0d7de; border-radius:6px; padding:5px 8px; }
QFrame#toast[kind="success"] { border-left:4px solid #2e9b5f; }
QFrame#toast[kind="warning"] { border-left:4px solid #d99a2b; }
QFrame#toast[kind="error"] { border-left:4px solid #e5484d; }
